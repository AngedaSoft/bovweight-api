APP_NAME=BovWeightCR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_TIMEZONE=America/Costa_Rica

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ============================================================
#  Base de datos - configuracion local de desarrollo
# ============================================================
# Para desarrollo local recomendamos XAMPP o Laragon (MySQL 8).
# Crear manualmente la BD vacia 'bovweight_dev' antes de migrar.
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bovweight_dev
DB_USERNAME=root
DB_PASSWORD=

# Para apuntar a la BD remota (Hostinger u otro), recordar:
# 1. Activar Remote MySQL en el panel y autorizar la IP publica
# 2. NO commitear el .env real
# 3. Rotar credenciales si fueron expuestas

# ============================================================
#  Sanctum
# ============================================================
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8100,127.0.0.1,127.0.0.1:8000

# ============================================================
#  Servicio de IA (microservicio Flask + YOLOv8)
# ============================================================
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_TOKEN=

# ============================================================
#  DigitalOcean Spaces (S3-compatible)
# ============================================================
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=

# ============================================================
#  Mail (SMTP para recuperacion de contrasena y notificaciones)
# ============================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@bovweight.cr"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
#  Cache, sessions y queues (Laravel 11)
# ============================================================
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
