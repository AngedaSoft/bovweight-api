# <type>(<scope>): <subject>
#
# <body>
#
# <footer>
#
# ============================================================
#  Conventional Commits - guia rapida
# ============================================================
#
# Tipos permitidos:
#   feat:     Nueva funcionalidad para el usuario
#   fix:      Correccion de bug
#   docs:     Cambios en documentacion
#   style:    Formato (espacios, comas, sin cambio de codigo)
#   refactor: Cambio de codigo que no es feat ni fix
#   perf:     Cambio que mejora el rendimiento
#   test:     Agregar o corregir pruebas
#   chore:    Cambios en build, herramientas, dependencias
#   ci:       Cambios en CI/CD
#   revert:   Revertir un commit previo
#
# Scopes sugeridos para BovWeight CR:
#   auth, api, db, models, migrations, ai, fincas, animales,
#   pesajes, reportes, transferencias, notifs, deps
#
# Ejemplos:
#   feat(auth): agregar endpoint de login con Sanctum
#   fix(pesajes): corregir calculo de peso corregido cuando es nulo
#   docs(readme): documentar como correr migraciones
#   chore(deps): actualizar Laravel a 11.5
#
# ============================================================
