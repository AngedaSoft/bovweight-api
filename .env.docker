APP_NAME=BovWeightCR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Costa_Rica

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bovweight_dev
DB_USERNAME=bovweight
DB_PASSWORD=bovweight

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8100,127.0.0.1

AI_SERVICE_URL=http://ml-service:5000
AI_SERVICE_TOKEN=

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@bovweight.cr"
MAIL_FROM_NAME="${APP_NAME}"
